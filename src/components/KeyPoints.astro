---
// 글 맨 위 "한눈에 보기" 박스: 바쁜 사장님이 결론만 보고 갈 수 있게.
interface Props {
  points: { label: string; value: string }[];
  color: string;
  dark: string;
}
const { points, color, dark } = Astro.props;
---

<section class="keypoints" aria-label="한눈에 보기" style={`--c:${color};--c-dark:${dark}`}>
  <p class="kp-title">한눈에 보기</p>
  <dl>
    {
      points.map((p) => (
        <div class="kp-row">
          <dt>{p.label}</dt>
          <dd>{p.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .keypoints {
    --cc: var(--c);
    border: 2px solid var(--ink);
    border-top: 8px solid var(--cc);
    padding: 1.1rem 1.4rem 0.6rem;
    margin-block: 0.5rem 2rem;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .keypoints {
      --cc: var(--c-dark);
    }
  }
  .kp-title {
    margin: 0 0 0.4rem;
    font-weight: 800;
    font-size: var(--step--1);
    color: var(--cc);
  }
  dl {
    margin: 0;
  }
  .kp-row {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1rem;
    padding-block: 0.6rem;
    border-top: 1px solid var(--rule);
  }
  dt {
    font-weight: 700;
    color: var(--ink-soft);
    font-size: var(--step--1);
    padding-top: 0.1rem;
  }
  dd {
    margin: 0;
    font-weight: 700;
    font-size: var(--step-0);
    line-height: 1.5;
  }
  @media (max-width: 30rem) {
    .kp-row {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
</style>
