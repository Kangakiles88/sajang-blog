---
// 부가세 예상 납부액 계산기 (일반과세자 / 간이과세자)
// 공제율·한도 기준: 2026년 12월 31일까지 공급분 1.3%·연 1,000만 원,
// 2027년 정부 세제개편안 1.2%·연 500만 원(국회 확정 전).
interface Props {
  embedded?: boolean;
}
const { embedded = false } = Astro.props;

const RATES = [
  { v: '0.15', label: '소매업, 음식점업, 재생용 재료 수집·판매업 (15%)' },
  { v: '0.2', label: '제조업, 농업·임업·어업, 소화물 전문 운송업 (20%)' },
  { v: '0.25', label: '숙박업 (25%)' },
  { v: '0.3', label: '건설업, 운수·창고업, 정보통신업, 그 밖의 서비스업 (30%)' },
  { v: '0.4', label: '금융·보험 서비스업, 전문·과학·기술 서비스업, 부동산 관련·임대업 등 (40%)' },
];
---

<section class={`calc ${embedded ? 'embedded' : ''}`} data-vat aria-labelledby="vat-title">
  {embedded && <h2 id="vat-title">내 부가세 바로 계산해 보기</h2>}
  {!embedded && <h2 id="vat-title" class="sr">입력</h2>}

  <form class="form" novalidate>
    <fieldset class="seg">
      <legend>과세 유형</legend>
      <label><input type="radio" name="type" value="general" checked /> 일반과세자</label>
      <label><input type="radio" name="type" value="simple" /> 간이과세자</label>
    </fieldset>

    <label class="field">
      <span class="lab">이번 신고기간 총매출 <small>부가세 포함 금액</small></span>
      <span class="money"><input name="sales" inputmode="numeric" autocomplete="off" placeholder="예: 55,000,000" /><span>원</span></span>
      <span class="hint" data-period>일반과세자는 6개월(1~6월 또는 7~12월) 매출을 넣으세요.</span>
    </label>

    <label class="field">
      <span class="lab">그중 카드·현금영수증·간편결제 매출 <small>부가세 포함</small></span>
      <span class="money"><input name="card" inputmode="numeric" autocomplete="off" placeholder="예: 40,000,000" /><span>원</span></span>
    </label>

    <label class="field">
      <span class="lab">공제받을 매입 <small>세금계산서·사업용 카드로 산 것, 부가세 포함</small></span>
      <span class="money"><input name="purchase" inputmode="numeric" autocomplete="off" placeholder="예: 22,000,000" /><span>원</span></span>
    </label>

    <label class="field simple-only" hidden>
      <span class="lab">업종</span>
      <select name="rate">
        {RATES.map((r) => <option value={r.v}>{r.label}</option>)}
      </select>
    </label>

    <details class="more">
      <summary>카드매출 세액공제 조건 바꾸기</summary>
      <label class="field">
        <span class="lab">공제 기준</span>
        <select name="rule">
          <option value="2026">2026년 공급분까지 (1.3%, 연 1,000만 원)</option>
          <option value="2027">2027년 정부안, 미확정 (1.2%, 연 500만 원)</option>
        </select>
      </label>
      <label class="field">
        <span class="lab">올해 앞선 신고에서 이미 받은 카드매출 공제액</span>
        <span class="money"><input name="used" inputmode="numeric" autocomplete="off" placeholder="0" /><span>원</span></span>
      </label>
      <label class="check"><input type="checkbox" name="big" /> 직전연도 공급가액이 10억 원을 넘었습니다 (카드매출 세액공제 대상 아님)</label>
    </details>
  </form>

  <div class="result" aria-live="polite">
    <p class="res-label" data-res-label>예상 납부세액</p>
    <p class="res-num" data-res-num>0원</p>
    <table class="breakdown">
      <tbody data-rows></tbody>
    </table>
    <p class="note" data-note></p>
  </div>

  <p class="fine">
    단순화한 추정치입니다. 의제매입세액공제, 예정고지 납부액, 가산세, 공제받지 못하는 매입(접대비, 비영업용 승용차 등)은 반영하지 않습니다. 실제 신고는 홈택스나 세무사를 통해 확인하세요.
  </p>
</section>

<script>
  const won = (n: number) => Math.round(n).toLocaleString('ko-KR') + '원';
  const num = (s: string) => Number((s || '').replace(/[^0-9]/g, '')) || 0;

  document.querySelectorAll<HTMLElement>('[data-vat]').forEach((root) => {
    const form = root.querySelector('form')!;
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;

    // 금액 입력에 쉼표 자동 표시
    form.querySelectorAll<HTMLInputElement>('.money input').forEach((inp) => {
      inp.addEventListener('input', () => {
        const pos = inp.value.length - inp.selectionStart!;
        const v = num(inp.value);
        inp.value = v ? v.toLocaleString('ko-KR') : '';
        const p = Math.max(0, inp.value.length - pos);
        inp.setSelectionRange(p, p);
      });
    });

    const calc = () => {
      const f = new FormData(form);
      const type = f.get('type') as string;
      const sales = num(f.get('sales') as string);
      const card = Math.min(num(f.get('card') as string), sales);
      const purchase = num(f.get('purchase') as string);
      const rule = f.get('rule') as string;
      const used = num(f.get('used') as string);
      const big = f.get('big') === 'on';
      const cardRate = rule === '2027' ? 0.012 : 0.013;
      const cardCap = rule === '2027' ? 5_000_000 : 10_000_000;

      root.querySelectorAll<HTMLElement>('.simple-only').forEach((el) => (el.hidden = type !== 'simple'));
      $('[data-period]').textContent =
        type === 'simple'
          ? '간이과세자는 1년(1~12월) 매출을 넣으세요. 1월에 한 번 신고합니다.'
          : '일반과세자는 6개월(1~6월 또는 7~12월) 매출을 넣으세요.';

      const rows: [string, number][] = [];
      let tax = 0;
      let refund = 0;
      let note = '';
      const cardCredit = big ? 0 : Math.max(0, Math.min(card * cardRate, cardCap - used));

      if (type === 'general') {
        const out = (sales * 10) / 110;
        const inn = (purchase * 10) / 110;
        const base = out - inn;
        rows.push(['매출세액 (총매출의 10/110)', out], ['매입세액 공제 (매입의 10/110)', -inn]);
        if (base < 0) {
          refund = -base;
          rows.push(['카드매출 세액공제', 0]);
          note = '매입세액이 매출세액보다 커서 환급 대상입니다. 카드매출 세액공제는 환급액을 늘리지 않습니다.';
        } else {
          const c = Math.min(cardCredit, base);
          rows.push([`카드매출 세액공제 (${(cardRate * 100).toFixed(1)}%)`, -c]);
          tax = base - c;
          if (c < cardCredit) note = '카드매출 세액공제는 낼 세금을 넘는 만큼은 사라집니다.';
        }
      } else {
        const rate = Number(f.get('rate'));
        const out = sales * rate * 0.1;
        const inn = purchase * 0.005;
        rows.push([`매출 × 부가가치율 ${rate * 100}% × 10%`, out], ['매입 공제 (매입의 0.5%)', -Math.min(inn, out)]);
        const base = Math.max(0, out - inn);
        const c = Math.min(cardCredit, base);
        rows.push([`카드매출 세액공제 (${(cardRate * 100).toFixed(1)}%)`, -c]);
        tax = base - c;
        note = '간이과세자는 공제가 납부세액을 넘어도 환급되지 않습니다.';
        if (sales > 0 && sales < 48_000_000) {
          tax = 0;
          note = '연 매출(공급대가) 4,800만 원 미만 간이과세자는 납부의무가 면제됩니다. 신고는 해야 합니다.';
        }
      }

      $('[data-res-label]').textContent = refund > 0 ? '예상 환급세액' : '예상 납부세액';
      $('[data-res-num]').textContent = won(refund > 0 ? refund : Math.max(0, tax));
      $('[data-rows]').innerHTML = rows
        .map(([k, v]) => `<tr><th scope="row">${k}</th><td>${v < 0 ? '−' : ''}${won(Math.abs(v))}</td></tr>`)
        .join('');
      $('[data-note]').textContent = note;
    };

    form.addEventListener('input', calc);
    form.addEventListener('change', calc);
    calc();
  });
</script>

<style>
  .calc {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: 1.5rem 2.5rem;
    align-items: start;
  }
  .calc.embedded {
    grid-template-columns: 1fr;
    margin-block: 3rem;
    padding: 1.5rem;
    border: 2px solid var(--ink);
  }
  .calc > h2 {
    grid-column: 1 / -1;
    font-size: var(--step-1);
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .form {
    display: grid;
    gap: 1.25rem;
  }
  .seg {
    border: 0;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 0.5rem;
  }
  .seg legend {
    font-weight: 700;
    margin-bottom: 0.4rem;
    font-size: var(--step--1);
  }
  .seg label {
    flex: 1;
    position: relative;
  }
  .seg input {
    position: absolute;
    opacity: 0;
  }
  .seg label:has(input) {
    text-align: center;
    padding: 0.7rem;
    border: 2px solid var(--rule-strong);
    font-weight: 700;
    cursor: pointer;
  }
  .seg label:has(input:checked) {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }
  .seg label:has(input:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .field {
    display: grid;
    gap: 0.35rem;
  }
  .lab {
    font-weight: 700;
    font-size: var(--step--1);
  }
  .lab small {
    font-weight: 400;
    color: var(--muted);
    margin-left: 0.25rem;
  }
  .money {
    display: flex;
    align-items: center;
    border-bottom: 2px solid var(--ink);
  }
  .money input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: var(--step-1);
    font-weight: 700;
    padding: 0.4rem 0;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .money input::placeholder {
    color: var(--muted);
    font-weight: 400;
    opacity: 0.7;
  }
  .money span {
    margin-left: 0.4rem;
    color: var(--muted);
  }
  select {
    font: inherit;
    font-size: var(--step--1);
    padding: 0.55rem;
    border: 2px solid var(--rule-strong);
    background: var(--paper);
    color: var(--ink);
    width: 100%;
  }
  .hint {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .more summary {
    cursor: pointer;
    font-weight: 600;
    font-size: var(--step--1);
    color: var(--link);
  }
  .more[open] {
    display: grid;
    gap: 1rem;
  }
  .more[open] summary {
    margin-bottom: 0.25rem;
  }
  .check {
    font-size: var(--step--1);
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
  }
  .check input {
    margin-top: 0.4rem;
  }
  .result {
    background: var(--ledger);
    padding: 1.5rem;
    position: sticky;
    top: 1rem;
  }
  .res-label {
    margin: 0;
    font-weight: 700;
    font-size: var(--step--1);
  }
  .res-num {
    margin: 0.25rem 0 1rem;
    font-size: clamp(2rem, 6vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }
  .breakdown {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .breakdown :global(th),
  .breakdown :global(td) {
    border-top: 1px solid var(--rule);
    padding: 0.5rem 0;
    font-weight: 400;
    text-align: left;
  }
  .breakdown :global(td) {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    padding-left: 1rem;
  }
  .note {
    font-size: 0.9rem;
    color: var(--ink-soft);
    margin: 0.75rem 0 0;
  }
  .note:empty {
    display: none;
  }
  .fine {
    grid-column: 1 / -1;
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0;
  }
  @media (max-width: 52rem) {
    .calc {
      grid-template-columns: 1fr;
    }
    .result {
      position: static;
    }
  }
</style>
