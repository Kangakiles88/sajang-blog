---
import type { CollectionEntry } from 'astro:content';
import { getCategory } from '../site.config';
import { formatDate } from '../lib/format';
import CategoryTag from './CategoryTag.astro';

interface Props {
  posts: CollectionEntry<'posts'>[];
  showCategory?: boolean;
}
const { posts, showCategory = true } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="empty">아직 올라온 글이 없습니다. 곧 채워집니다.</p>
  ) : (
    <ul class="ledger-list">
      {posts.map((p) => {
        const d = p.data.updatedDate ?? p.data.pubDate;
        const c = getCategory(p.data.category);
        return (
          <li class="item" style={`--c:${c.color};--c-dark:${c.dark}`}>
            {showCategory && <CategoryTag slug={p.data.category} />}
            <a href={`/posts/${p.id}/`} class="title">
              {p.data.title}
            </a>
            <p class="desc">{p.data.description}</p>
            <time class="date" datetime={d.toISOString()}>
              {p.data.updatedDate ? `${formatDate(d)} 수정` : formatDate(d)}
            </time>
          </li>
        );
      })}
    </ul>
  )
}

<style>
  .item {
    padding: 1.25rem 0 1.25rem 1rem;
    border-left: 4px solid var(--c);
    display: grid;
    gap: 0.3rem;
    justify-items: start;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .item {
      border-left-color: var(--c-dark);
    }
  }
  .title {
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.4;
  }
  .title:hover {
    text-decoration: underline;
  }
  .desc {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
    max-width: 40rem;
    line-height: 1.6;
  }
  .date {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .empty {
    color: var(--muted);
    padding-block: 1rem;
  }
</style>
