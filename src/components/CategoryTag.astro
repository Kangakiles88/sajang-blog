---
// 카테고리 표시: 색 아이콘 + 이름. 카테고리 색은 site.config.ts에서 정합니다.
import { getCategory } from '../site.config';

interface Props {
  slug: string;
  link?: boolean;
  size?: 'sm' | 'md';
}
const { slug, link = true, size = 'sm' } = Astro.props;
const c = getCategory(slug);
const Tag = link ? 'a' : 'span';
---

<Tag
  class={`cat-tag ${size}`}
  href={link ? `/category/${c.slug}/` : undefined}
  style={`--c:${c.color};--c-dark:${c.dark}`}
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d={c.icon}></path>
  </svg>
  <span>{c.name}</span>
</Tag>

<style>
  .cat-tag {
    --cc: var(--c);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--cc);
    font-weight: 700;
    text-decoration: none;
    line-height: 1.2;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .cat-tag {
      --cc: var(--c-dark);
    }
  }
  .cat-tag svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex: none;
  }
  .sm {
    font-size: 0.85rem;
  }
  .sm svg {
    width: 1.05rem;
    height: 1.05rem;
  }
  .md {
    font-size: var(--step--1);
  }
  .md svg {
    width: 1.3rem;
    height: 1.3rem;
  }
  a.cat-tag:hover span {
    text-decoration: underline;
  }
</style>
