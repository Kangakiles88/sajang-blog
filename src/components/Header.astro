---
import { SITE, CATEGORIES } from '../site.config';
import Logo from './Logo.astro';
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label={`${SITE.name} 홈`}>
      <Logo />
      <span>{SITE.name}</span>
    </a>
    <nav class="cats" aria-label="카테고리">
      <ul>
        {
          CATEGORIES.map((c) => (
            <li>
              <a
                href={`/category/${c.slug}/`}
                aria-current={path.startsWith(`/category/${c.slug}`) ? 'page' : undefined}
                style={`--c:${c.color}`}
              >
                {c.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  /* 초록 네브바 */
  .site-header {
    background: var(--accent);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 0.9rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #fff;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.2rem;
    letter-spacing: -0.03em;
    flex: none;
  }
  .cats {
    min-width: 0;
  }
  .cats ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .cats a {
    display: block;
    white-space: nowrap;
    color: rgb(255 255 255 / 0.78);
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 600;
    padding-block: 0.2rem;
    border-bottom: 2px solid transparent;
  }
  .cats a:hover {
    color: #fff;
  }
  .cats a[aria-current='page'] {
    color: #fff;
    border-bottom-color: var(--mark);
  }
  @media (max-width: 48rem) {
    .bar {
      flex-direction: column;
      align-items: flex-start;
      padding-block: 0.9rem 0.75rem;
    }
    .cats {
      width: 100%;
    }
    .cats ul {
      gap: 1.25rem;
    }
  }
</style>
