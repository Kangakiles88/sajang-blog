  "steps": [
    { "key": "premium", "expr": "grade == 1 ? prem1 : grade == 2 ? prem2 : grade == 3 ? prem3 : grade == 4 ? prem4 : grade == 5 ? prem5 : grade == 6 ? prem6 : prem7" },
    { "key": "govRate", "expr": "grade <= 2 ? govHigh : grade <= 4 ? govMid : govLow" },
    { "key": "gov", "expr": "govOn == 1 ? round(premium * govRate) : 0" },
    { "key": "local", "expr": "min(round(premium * localRate / 100), premium - gov)" },
    { "key": "net", "expr": "max(premium - gov - local, 0)" },
    { "key": "netYear", "expr": "net * 12" },
    { "key": "dayAmount", "expr": "grade == 1 ? day1 : grade == 2 ? day2 : grade == 3 ? day3 : grade == 4 ? day4 : grade == 5 ? day5 : grade == 6 ? day6 : day7" },
    { "key": "benefitDays", "expr": "years < yMin ? 0 : years < yMid1 ? daysA : years < yMid2 ? daysB : years < yMax ? daysC : daysD" },
    { "key": "benefitTotal", "expr": "dayAmount * benefitDays" }
  ],
  "outputs": [
    { "key": "net", "label": "매달 실제로 내는 보험료", "format": "won", "primary": true },
    { "key": "premium", "label": "월 보험료 (지원 전)", "format": "won" },
