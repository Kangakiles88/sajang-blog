  "steps": [
    { "key": "premium", "expr": "grade == 1 ? prem1 : grade == 2 ? prem2 : grade == 3 ? prem3 : grade == 4 ? prem4 : grade == 5 ? prem5 : grade == 6 ? prem6 : prem7" },
    { "key": "govRate", "expr": "grade <= 2 ? govHigh : grade <= 4 ? govMid : govLow" },
    { "key": "gov", "expr": "govOn == 1 ? round(premium * govRate) : 0" },
    { "key": "seoul", "expr": "seoulOn == 1 ? round(premium * seoulRate) : 0" },
    { "key": "net", "expr": "max(premium - gov - seoul, 0)" },
    { "key": "netYear", "expr": "net * 12" },
    { "key": "benefit", "expr": "grade == 1 ? ben1 : grade == 2 ? ben2 : grade == 3 ? ben3 : grade == 4 ? ben4 : grade == 5 ? ben5 : grade == 6 ? ben6 : ben7" }
  ],
  "outputs": [
    { "key": "net", "label": "매달 실제로 내는 보험료", "format": "won", "primary": true },
