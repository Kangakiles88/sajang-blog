  ],
  "steps": [
    {
      "key": "after",
      "expr": "max(0, base - extra)"
    },
    {
      "key": "taxBefore",
      "expr": "round(r1 * min(base, b1) + r2 * max(0, min(base, b2) - b1) + r3 * max(0, min(base, b3) - b2) + r4 * max(0, min(base, b4) - b3) + r5 * max(0, min(base, b5) - b4) + r6 * max(0, min(base, b6) - b5) + r7 * max(0, min(base, b7) - b6) + r8 * max(0, base - b7))"
    },
    {
      "key": "taxAfter",
      "expr": "round(r1 * min(after, b1) + r2 * max(0, min(after, b2) - b1) + r3 * max(0, min(after, b3) - b2) + r4 * max(0, min(after, b4) - b3) + r5 * max(0, min(after, b5) - b4) + r6 * max(0, min(after, b6) - b5) + r7 * max(0, min(after, b7) - b6) + r8 * max(0, after - b7))"
    },
    {
      "key": "incomeTaxSaving",
      "expr": "taxBefore - taxAfter"
    },
    {
      "key": "localTaxSaving",
      "expr": "round(incomeTaxSaving * localRatio)"
    },
    {
      "key": "saving",
      "expr": "incomeTaxSaving + localTaxSaving"
    }
  ],
  "outputs": [
    {
      "key": "saving",
      "label": "줄어드는 세금 (지방소득세 포함, 어림값)",
      "format": "won",
      "primary": true
    },
    {
      "key": "incomeTaxSaving",
      "label": "줄어드는 종합소득세",
      "format": "won"
    },
    {
      "key": "localTaxSaving",
      "label": "줄어드는 지방소득세",
      "format": "won"
    },
    {
      "key": "taxBefore",
      "label": "경비 반영 전 산출세액",
      "format": "won"
    },
    {
      "key": "taxAfter",
      "label": "경비 반영 후 산출세액",
      "format": "won"
    }
  ],
  "notes": [
    {
      "when": "extra > base",
      "text": "추가 경비가 과세표준보다 커서 과세표준이 0원이 됩니다. 남는 금액은 결손금이 될 수 있지만 이 계산기에는 반영하지 않았습니다."
    },
    {
      "when": "base > b1 && after <= b1",
      "text": "경비를 넣으면 과세표준이 더 낮은 세율 구간으로 내려갑니다. 그래서 '경비 × 내 최고세율'보다 실제로 줄어드는 세금이 적습니다."
    }
  ],
  "fine": "산출세액(세율을 곱한 세금) 차이만 계산한 어림값입니다. 세액공제·감면, 기납부세액, 가산세, 경비율로 신고하는 추계 신고자의 계산 방식, 지자체 조례에 따른 지방소득세율 조정은 반영하지 않았습니다. 경비는 사업과 관련 있고 증빙이 있어야 인정됩니다. 2026년 1월 1일 시행 소득세법 제55조 세율 기준입니다.",
  "method": [
    {
      "heading": "세율 구간",
      "text": "소득세법 제55조제1항 세율표를 그대로 씁니다. 과세표준 1,400만 원 이하 6%, 5,000만 원 이하 15%, 8,800만 원 이하 24%, 1억5천만 원 이하 35%, 3억 원 이하 38%, 5억 원 이하 40%, 10억 원 이하 42%, 10억 원 초과 45%를 각 구간에 해당하는 금액에만 적용해 더합니다."
    },
    {
      "heading": "줄어드는 세금",
      "text": "경비를 넣기 전 과세표준과, 거기서 추가 경비를 뺀 과세표준의 세금을 각각 계산해 차이를 구합니다. 개인지방소득세는 소득세 세율의 10분의 1이므로 줄어든 소득세의 10%를 더합니다."
    }
  ],
  "tests": [
    {
      "inputs": {
        "base": 14000000,
        "extra": 1000000
      },
      "expect": {
        "taxBefore": 840000,
        "taxAfter": 780000,
        "incomeTaxSaving": 60000,
        "localTaxSaving": 6000,
        "saving": 66000
      },
      "why": "경계값 1,400만 원은 '1,400만원 이하'라 전부 6%: 1,400만×6%=84만. 경비 100만을 빼면 1,300만×6%=78만. 차이 6만, 지방 6천, 합계 6만6천 원"
    },
    {
      "inputs": {
        "base": 50000000,
        "extra": 3000000
      },
      "expect": {
        "taxBefore": 6240000,
        "taxAfter": 5790000,
        "incomeTaxSaving": 450000,
        "localTaxSaving": 45000,
        "saving": 495000
      },
      "why": "경계값 5,000만 원: 84만+3,600만×15%=624만(법 세율표의 624만원과 같음). 4,700만: 84만+3,300만×15%=495만. 차이 45만, 지방 4만5천, 합계 49만5천 원"
    },
    {
      "inputs": {
        "base": 52000000,
        "extra": 4000000
      },
      "expect": {
        "taxBefore": 6720000,
        "taxAfter": 5940000,
        "incomeTaxSaving": 780000,
        "localTaxSaving": 78000,
        "saving": 858000
      },
      "why": "구간을 걸치는 경우. 5,200만: 624만+200만×24%=672만. 4,800만: 84만+3,400만×15%=594만. 차이 78만(200만×24%+200만×15%=48만+30만), 지방 7만8천, 합계 85만8천 원"
    },
    {
      "inputs": {
        "base": 88000000,
        "extra": 0
      },
      "expect": {
        "taxBefore": 15360000,
        "taxAfter": 15360000,
        "incomeTaxSaving": 0,
        "localTaxSaving": 0,
        "saving": 0
      },
      "why": "경계값 8,800만 원: 624만+3,800만×24%=1,536만(세율표 1,536만원과 같음). 경비 0원이라 절세 0원"
    },
    {
      "inputs": {
        "base": 1000000000,
        "extra": 0
      },
      "expect": {
        "taxBefore": 384060000,
        "saving": 0
      },
      "why": "경계값 10억 원: 84만+540만+912만+2,170만+5,700만+8,000만+2억1,000만=3억8,406만 원. 5억 구간 누적 1억7,406만(세율표와 같음)+5억×42%=2억1,000만"
    },
    {
      "inputs": {
        "base": 10000000,
        "extra": 12000000
      },
      "expect": {
        "taxBefore": 600000,
        "taxAfter": 0,
        "incomeTaxSaving": 600000,
        "localTaxSaving": 60000,
        "saving": 660000
      },
      "why": "경비가 과세표준보다 크면 과세표준 0원. 1,000만×6%=60만이 전부 줄고, 지방 6만, 합계 66만 원"
    }
  ]
}