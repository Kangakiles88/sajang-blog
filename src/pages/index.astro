---
import Base from '../layouts/Base.astro';
import DeadlineBoard from '../components/DeadlineBoard.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../site.config';
import { getPublishedPosts } from '../lib/posts';

const posts = (await getPublishedPosts()).slice(0, 10);

// 제목 마지막 구절("놓치면 안 되는 날")만 포인트 색으로
const cut = SITE.tagline.lastIndexOf(', ');
const [lead, tail] = cut > 0 ? [SITE.tagline.slice(0, cut + 2), SITE.tagline.slice(cut + 2)] : ['', SITE.tagline];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  inLanguage: 'ko-KR',
};
---

<Base jsonLd={jsonLd}>
  <div class="wrap">
    <section class="intro">
      <h1>{lead}<em>{tail}</em></h1>
      <p>정책자금·지원사업·세금 공고를 원문 그대로 읽고, 사장님이 궁금한 것만 정리합니다.</p>
    </section>

    <div class="grid">
      <section aria-labelledby="latest">
        <h2 id="latest" class="sec">새로 올라온 글</h2>
        <PostList posts={posts} />
      </section>

      <aside>
        <DeadlineBoard compact />
      </aside>
    </div>
  </div>
</Base>

<style>
  .intro {
    padding-block: 3rem 2.5rem;
    max-width: 52rem;
  }
  .intro h1 {
    font-size: clamp(1.6rem, 4.2vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.3;
  }
  .intro em {
    font-style: normal;
    color: var(--accent);
  }
  .intro p {
    color: var(--muted);
    margin: 0.75rem 0 0;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18rem;
    gap: 4rem;
    align-items: start;
  }
  .sec {
    font-size: var(--step--1);
    font-weight: 800;
    color: var(--accent);
    margin-bottom: 0.25rem;
  }
  aside {
    position: sticky;
    top: 1.5rem;
  }
  @media (max-width: 56rem) {
    .grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    aside {
      position: static;
    }
  }
</style>
