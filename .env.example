# 로컬 테스트용입니다. .env 로 복사해서 쓰세요.
# 실제 사이트는 GitHub Actions에서 빌드됩니다. 애드센스 값은 GitHub 저장소 > Settings > Secrets and variables > Actions > Variables 에 넣으세요.
# (주소, GA4, 서치 콘솔·네이버 인증값은 코드에 기본값이 들어 있어 따로 넣지 않아도 됩니다.)

# 사이트 주소 (도메인 연결 후 바꾸기)
SITE_URL=https://sajang-note.com

# 애드센스 승인 후 입력 (ca-pub-로 시작)
PUBLIC_ADSENSE_CLIENT=
# 애드센스에서 만든 디스플레이 광고 단위의 슬롯 ID (숫자)
PUBLIC_ADSENSE_SLOT=

# 구글 애널리틱스 측정 ID (G-로 시작)
PUBLIC_GA_ID=

# 서치 콘솔 / 네이버 서치어드바이저 HTML 태그 인증값 (content="..." 안의 값만)
PUBLIC_GOOGLE_VERIFY=
PUBLIC_NAVER_VERIFY=
