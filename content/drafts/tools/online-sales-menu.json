    { "inputs": { "pick1": 5, "pick2": 1, "pick3": 2, "pick4": 0 },
      "expect": { "gov": 7488000, "selfPay": 832000, "vat": 832000, "pay": 1664000, "remain": 0, "over": 1488000 },
