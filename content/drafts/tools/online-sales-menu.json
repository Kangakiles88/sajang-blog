  "steps": [
    { "key": "g1", "expr": "pick1 == 1 ? govProduct : pick1 == 2 ? govDetail : pick1 == 3 ? govContent : pick1 == 4 ? govMall : pick1 == 5 ? govLive : pick1 == 6 ? govSns : pick1 == 7 ? govAd : pick1 == 8 ? govLogistics : 0" },
    { "key": "g2", "expr": "pick2 == 1 ? govProduct : pick2 == 2 ? govDetail : pick2 == 3 ? govContent : pick2 == 4 ? govMall : pick2 == 5 ? govLive : pick2 == 6 ? govSns : pick2 == 7 ? govAd : pick2 == 8 ? govLogistics : 0" },
    { "key": "g3", "expr": "pick3 == 1 ? govProduct : pick3 == 2 ? govDetail : pick3 == 3 ? govContent : pick3 == 4 ? govMall : pick3 == 5 ? govLive : pick3 == 6 ? govSns : pick3 == 7 ? govAd : pick3 == 8 ? govLogistics : 0" },
    { "key": "g4", "expr": "pick4 == 1 ? govProduct : pick4 == 2 ? govDetail : pick4 == 3 ? govContent : pick4 == 4 ? govMall : pick4 == 5 ? govLive : pick4 == 6 ? govSns : pick4 == 7 ? govAd : pick4 == 8 ? govLogistics : 0" },
    { "key": "s1", "expr": "pick1 == 1 ? selfProduct : pick1 == 2 ? selfDetail : pick1 == 3 ? selfContent : pick1 == 5 ? selfLive : pick1 == 6 ? selfSns : pick1 == 7 ? selfAd : pick1 == 8 ? selfLogistics : 0" },
    { "key": "s2", "expr": "pick2 == 1 ? selfProduct : pick2 == 2 ? selfDetail : pick2 == 3 ? selfContent : pick2 == 5 ? selfLive : pick2 == 6 ? selfSns : pick2 == 7 ? selfAd : pick2 == 8 ? selfLogistics : 0" },
    { "key": "s3", "expr": "pick3 == 1 ? selfProduct : pick3 == 2 ? selfDetail : pick3 == 3 ? selfContent : pick3 == 5 ? selfLive : pick3 == 6 ? selfSns : pick3 == 7 ? selfAd : pick3 == 8 ? selfLogistics : 0" },
    { "key": "s4", "expr": "pick4 == 1 ? selfProduct : pick4 == 2 ? selfDetail : pick4 == 3 ? selfContent : pick4 == 5 ? selfLive : pick4 == 6 ? selfSns : pick4 == 7 ? selfAd : pick4 == 8 ? selfLogistics : 0" },
    { "key": "v1", "expr": "s1 > 0 ? round((g1 + s1) * vatRate) : 0" },
    { "key": "v2", "expr": "s2 > 0 ? round((g2 + s2) * vatRate) : 0" },
    { "key": "v3", "expr": "s3 > 0 ? round((g3 + s3) * vatRate) : 0" },
    { "key": "v4", "expr": "s4 > 0 ? round((g4 + s4) * vatRate) : 0" },
    { "key": "gov", "expr": "g1 + g2 + g3 + g4" },
    { "key": "selfPay", "expr": "s1 + s2 + s3 + s4" },
    { "key": "vat", "expr": "v1 + v2 + v3 + v4" },
    { "key": "pay", "expr": "selfPay + vat" },
    { "key": "remain", "expr": "max(0, capTotal - gov)" },
    { "key": "over", "expr": "max(0, gov - capTotal)" }
  ],
  "outputs": [
    { "key": "pay", "label": "사장님이 내는 돈 (자부담금 + 부가세)", "format": "won", "primary": true },
    { "key": "gov", "label": "고른 사업의 정부지원금 합계", "format": "won" },
    { "key": "selfPay", "label": "자부담금 합계", "format": "won" },
    { "key": "vat", "label": "부가가치세 합계", "format": "won" },
    { "key": "remain", "label": "600만 원 한도 중 남는 금액", "format": "won" },
    { "key": "over", "label": "600만 원 한도를 넘는 금액", "format": "won" }
  ],
  "notes": [
    { "when": "over > 0", "text": "정부지원금 합계가 기업당 한도 600만 원을 넘습니다. 신청은 4개까지 할 수 있지만, 실제 선정·지원은 한도 안에서만 됩니다. 우선순위와 심사 결과에 따라 일부 사업만 선정될 수 있습니다." },
    { "when": "(pick1 > 0 && (pick1 == pick2 || pick1 == pick3 || pick1 == pick4)) || (pick2 > 0 && (pick2 == pick3 || pick2 == pick4)) || (pick3 > 0 && pick3 == pick4)", "text": "같은 사업을 두 번 고르셨습니다. 메뉴판은 서로 다른 세부사업을 고르는 방식이니 하나만 남겨 주세요." },
    { "when": "pick1 == 4 || pick2 == 4 || pick3 == 4 || pick4 == 4", "text": "온라인쇼핑몰 판매지원은 공고에 자부담금이 '없음'으로 되어 있어 자부담금·부가세를 0원으로 계산했습니다." }
  ],
  "fine": "2026년 소상공인 온라인판로 지원사업 2차 모집공고(2026.5.27., 한국중소벤처기업유통원)의 사업별 정부지원금·자부담금 표를 그대로 옮긴 계산입니다. 선정 여부와 실제 선정되는 사업 조합은 심사 결과에 따라 달라집니다. 부가세는 각 사업의 사업비(공급가액)의 10%로 계산했고, 면세·간이과세자의 매입세액 처리나 2027년 공고의 변경 사항은 반영하지 않았습니다. 신청 전 판판대로의 최신 공고를 꼭 확인하세요.",
  "method": [
    { "heading": "계산 방식", "text": "고른 사업마다 공고 표의 정부지원금과 자부담금을 더하고, 자부담금이 있는 사업은 사업비(정부지원금 + 자부담금)의 10%를 부가세로 더합니다. 사장님이 실제로 내는 돈은 자부담금과 부가세의 합계입니다. 정부지원금 합계가 기업당 한도 600만 원을 넘는지도 함께 보여 줍니다." },
    { "heading": "기준 자료", "text": "2026년 소상공인 온라인판로 지원사업 참여기업 2차 모집공고(기업마당 게시, 2026.5.27.) 5쪽 지원한도 표와 <붙임1> 사업별 자부담금 표." }
  ],
  "tests": [
