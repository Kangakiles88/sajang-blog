{
  "id": "withholding-semiannual-headcount",
  "name": "원천세 반기납부 상시고용인원 계산기",
  "blurb": "직전 연도 매월 말일 직원 수로 반기납부 기준(20명 이하)을 넘는지 어림합니다",
  "category": "tax",
  "headline": "우리 가게, 원천세 반기납부 기준(상시고용 20명 이하)에 들까?",
  "description": "직전 연도 1월부터 12월까지 매월 말일 직원 수를 넣으면 소득세법 시행령 제186조 방식대로 평균 상시고용인원을 계산하고, 원천세 반기별 납부 기준인 20명 이하인지 어림합니다.",
  "inputs": [
    { "key": "industry", "label": "업종", "type": "select", "default": 0,
      "help": "금융 및 보험업을 하는 사업자는 인원과 관계없이 반기납부 대상이 아닙니다.",
      "options": [
        { "label": "금융·보험업이 아님", "value": 0 },
        { "label": "금융·보험업", "value": 1 }
      ] },
    { "key": "m1", "label": "1월 말일 직원 수", "type": "number", "default": 5, "help": "직전 연도(2026년에 신청하면 2026년) 1월 말일 현재 인원" },
    { "key": "m2", "label": "2월 말일 직원 수", "type": "number", "default": 5 },
    { "key": "m3", "label": "3월 말일 직원 수", "type": "number", "default": 5 },
    { "key": "m4", "label": "4월 말일 직원 수", "type": "number", "default": 5 },
    { "key": "m5", "label": "5월 말일 직원 수", "type": "number", "default": 5 },
    { "key": "m6", "label": "6월 말일 직원 수", "type": "number", "default": 5 },
    { "key": "m7", "label": "7월 말일 직원 수", "type": "number", "default": 5 },
    { "key": "m8", "label": "8월 말일 직원 수", "type": "number", "default": 5 },
    { "key": "m9", "label": "9월 말일 직원 수", "type": "number", "default": 5 },
    { "key": "m10", "label": "10월 말일 직원 수", "type": "number", "default": 5 },
    { "key": "m11", "label": "11월 말일 직원 수", "type": "number", "default": 5 },
    { "key": "m12", "label": "12월 말일 직원 수", "type": "number", "default": 5, "help": "아직 12월이 끝나지 않았다면 12월 말일에 있을 것으로 예상되는 인원을 넣으세요." }
  ],
  "constants": [
    { "key": "limit", "value": 20, "label": "반기납부 상시고용인원 기준 20명 이하",
      "source": "https://www.law.go.kr/법령/소득세법시행령/제186조", "evidence": "시행령 제186조제1항제1호 '직전 연도 … 의 상시고용인원이 20명 이하인 원천징수의무자(금융 및 보험업을 경영하는 자는 제외한다)'" },
    { "key": "months", "value": 12, "label": "평균을 내는 달 수(1월~12월)",
      "source": "https://www.law.go.kr/법령/소득세법시행령/제186조", "evidence": "시행령 제186조제2항 '직전 연도의 1월부터 12월까지의 매월 말일 현재의 상시고용인원의 평균인원수로 한다'" }
  ],
  "steps": [
    { "key": "total", "expr": "m1 + m2 + m3 + m4 + m5 + m6 + m7 + m8 + m9 + m10 + m11 + m12" },
    { "key": "avg", "expr": "total / months" },
    { "key": "pass", "expr": "industry == 0 && avg <= limit ? 1 : 0" },
    { "key": "gap", "expr": "limit - avg" }
  ],
  "outputs": [
    { "key": "avg", "label": "직전 연도 평균 상시고용인원 (명)", "format": "number", "primary": true },
    { "key": "gap", "label": "기준(20명)까지 남은 인원 (음수면 초과)", "format": "number" },
    { "key": "total", "label": "12개월 말일 인원 합계 (명)", "format": "number" }
  ],
  "notes": [
    { "when": "pass == 1", "text": "인원 기준(평균 20명 이하)은 채웁니다. 실제 승인 여부는 관할 세무서가 원천세 신고·납부 성실도 등을 함께 보고 정합니다." },
    { "when": "industry == 0 && pass == 0", "text": "평균이 20명을 넘어 반기납부 인원 기준을 채우지 못합니다. 원천세는 매달 다음 달 10일까지 냅니다." },
    { "when": "industry == 1", "text": "금융 및 보험업은 인원과 관계없이 반기납부 대상에서 빠집니다." }
  ],
  "fine": "소득세법 시행령 제186조제2항의 평균 계산만 따라 한 어림값입니다. 어떤 직원(일용직·단시간 직원 등)을 상시고용인원으로 세는지는 이 조문에 따로 적혀 있지 않으니, 경계에 가까우면 관할 세무서에 확인하세요. 신규 사업자는 직전 연도 대신 신청일이 속하는 반기를 기준으로 보므로 이 계산이 맞지 않습니다. 종교단체 기준과 세무서의 승인 심사(성실도)는 반영하지 않았습니다.",
  "method": [
    { "heading": "평균 상시고용인원", "text": "소득세법 시행령 제186조제2항에 따라 직전 연도 1월부터 12월까지 매월 말일 현재 인원을 더해 12로 나눕니다." },
    { "heading": "판정", "text": "시행령 제186조제1항제1호에 따라 평균이 20명 이하이고 금융·보험업이 아니면 인원 기준을 채운 것으로 봅니다. 20명 정확히도 '이하'라 기준 안입니다." }
  ],
  "tests": [
    { "inputs": { "industry": 0, "m1": 20, "m2": 20, "m3": 20, "m4": 20, "m5": 20, "m6": 20, "m7": 20, "m8": 20, "m9": 20, "m10": 20, "m11": 20, "m12": 20 },
      "expect": { "total": 240, "avg": 20, "pass": 1, "gap": 0 },
      "why": "경계값. 20명×12개월=240, 240÷12=20명. 20명 '이하'이므로 기준 안(pass 1), 남은 인원 0" },
    { "inputs": { "industry": 0, "m1": 22, "m2": 22, "m3": 22, "m4": 22, "m5": 19, "m6": 19, "m7": 19, "m8": 19, "m9": 19, "m10": 19, "m11": 19, "m12": 19 },
      "expect": { "total": 240, "avg": 20, "pass": 1, "gap": 0 },
      "why": "1~4월 22명(88)+5~12월 19명(152)=240, 240÷12=20명. 몇 달 20명을 넘어도 평균이 20명이면 기준 안" },
    { "inputs": { "industry": 0, "m1": 21, "m2": 21, "m3": 21, "m4": 21, "m5": 21, "m6": 21, "m7": 21, "m8": 21, "m9": 21, "m10": 21, "m11": 21, "m12": 21 },
      "expect": { "total": 252, "avg": 21, "pass": 0, "gap": -1 },
      "why": "21명×12=252, 252÷12=21명. 20명 초과라 기준 밖(pass 0), 남은 인원 20-21=-1" },
    { "inputs": { "industry": 1, "m1": 3, "m2": 3, "m3": 3, "m4": 3, "m5": 3, "m6": 3, "m7": 3, "m8": 3, "m9": 3, "m10": 3, "m11": 3, "m12": 3 },
      "expect": { "total": 36, "avg": 3, "pass": 0, "gap": 17 },
      "why": "3명×12=36, 평균 3명이지만 금융·보험업이라 대상 아님(pass 0). 남은 인원 20-3=17" },
    { "inputs": { "industry": 0, "m1": 2, "m2": 2, "m3": 3, "m4": 3, "m5": 3, "m6": 4, "m7": 4, "m8": 4, "m9": 4, "m10": 3, "m11": 3, "m12": 3 },
      "expect": { "total": 38, "avg": 3.1666666667, "pass": 1, "gap": 16.8333333333 },
      "why": "2+2+3+3+3+4+4+4+4+3+3+3=38, 38÷12=3.17명(소수점 그대로), 기준 안. 20-3.17=16.83" }
  ]
}
